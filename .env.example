# Creator search / data
# Injected automatically by the Neon Vercel Marketplace integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
OPENROUTER_API_KEY=

# Lead emails
RESEND_API_KEY=
RESEND_FROM="UGC VZ <hi@ugc-vz.de>"
UGC_INTERNAL_EMAIL=hi@ugc-vz.de
RESEND_WEBHOOK_SECRET=

# Secret token used only by the internal Google Sheet IMPORTDATA mirror.
SHEET_EXPORT_TOKEN=

# Separate token for the owner-only contact and consent mirror.
SHEET_PRIVATE_EXPORT_TOKEN=

# HMAC-Secret fuer die Creator-Session (Magic-Link-Login). Zufaellige, lange
# Zeichenkette (z. B. 64 Hex-Zeichen), ausschliesslich in Vercel hinterlegt.
CREATOR_SESSION_SECRET=

# Internal alerts and API access
SLACK_WEBHOOK_URL=
SUBMIT_REQUEST_API_KEY=

# Must remain false unless direct creator outreach has been explicitly approved.
SEND_CREATOR_OUTREACH_EMAILS=false
CREATOR_OUTREACH_MAX_PER_LEAD=8

# Public URLs
SITE_URL=https://ugc-vz.de
NEXT_PUBLIC_BASE_URL=https://ugc-vz.de

# MCP Events: SHA-256 bearer-token hashes, one separate token per connected account.
# Remove an account hash to revoke all its event access. Public tools stay public.
MCP_EVENTS_TOKEN_HASHES=
# 32 random bytes encoded as 64 hex characters; encrypts webhook signing secrets.
MCP_EVENTS_ENCRYPTION_KEY=
# Vercel cron authentication. Required for the event delivery worker.
CRON_SECRET=
